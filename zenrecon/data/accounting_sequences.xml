<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_bsr_accounting_configuration" model="ir.sequence">
        <field name="name">Bank Reconciliation Configuration</field>
        <field name="code">bsr.accounting.configuration</field>
        <field name="prefix">BSR/CONFIG/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bsr_accounting_report" model="ir.sequence">
        <field name="name">Bank Reconciliation Voucher Report</field>
        <field name="code">bsr.accounting.report</field>
        <field name="prefix">BSR/VOUCHER/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_bsr_accounting_run" model="ir.sequence">
        <field name="name">Bank Reconciliation Configuration Run</field>
        <field name="code">bsr.accounting.run</field>
        <field name="prefix">BSR/RUN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
