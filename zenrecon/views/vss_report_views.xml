<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         VSS-110 — one consolidated table per imported TXT file
         ============================================================ -->
    <record id="view_bsr_vss_110_consolidated_search" model="ir.ui.view">
        <field name="name">bsr.vss.110.consolidated.search</field>
        <field name="model">bsr.vss.110.line</field>
        <field name="arch" type="xml">
            <search string="Search VSS-110">
                <field name="import_id"/>
                <field name="processing_date"/>
                <field name="report_date"/>
                <field name="reporting_for_display"/>
                <field name="rollup_to_display"/>
                <field name="funds_xfer_entity_display"/>
                <field name="settlement_currency"/>
                <field name="particulars"/>
                <field name="entity"/>
                <field name="record_type"/>
                <group>
                    <filter string="Production Date" name="group_processing_date" context="{'group_by': 'processing_date'}"/>
                    <filter string="Reporting For" name="group_reporting_for" context="{'group_by': 'reporting_for_display'}"/>
                    <filter string="Settlement Currency" name="group_settlement_currency" context="{'group_by': 'settlement_currency'}"/>
                    <filter string="Particulars" name="group_particulars" context="{'group_by': 'particulars'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bsr_vss_110_consolidated_list" model="ir.ui.view">
        <field name="name">bsr.vss.110.consolidated.list</field>
        <field name="model">bsr.vss.110.line</field>
        <field name="arch" type="xml">
            <list string="VSS-110 Settlement Summary" class="o_bsr_vss_report_list" create="false" edit="false" delete="false">
                <field name="source_page" string="Page"/>
                <field name="sequence" string="SL#"/>
                <field name="processing_date" string="Production Date"/>
                <field name="report_date"/>
                <field name="report_code" string="Report ID"/>
                <field name="report_name"/>
                <field name="reporting_for_display" string="Reporting For"/>
                <field name="rollup_to_display" string="Rollup To"/>
                <field name="funds_xfer_entity_display" string="Funds Xfer Entity"/>
                <field name="settlement_currency"/>
                <field name="particulars"/>
                <field name="entity"/>
                <field name="count_display" string="Count"/>
                <field name="credit_amount"/>
                <field name="debit_amount"/>
                <field name="total_amount"/>
                <field name="direction" string="CR/DB"/>
                <field name="record_type"/>
                <field name="service_name" optional="hide"/>
                <field name="source_report_sequence" optional="hide"/>
                <field name="source_line_no" optional="hide"/>
                <field name="import_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_bsr_vss_110_consolidated" model="ir.actions.act_window">
        <field name="name">VSS-110</field>
        <field name="res_model">bsr.vss.110.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_bsr_vss_110_consolidated_list"/>
        <field name="search_view_id" ref="view_bsr_vss_110_consolidated_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

