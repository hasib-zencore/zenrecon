<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visa_vx_705_import_wizard_form" model="ir.ui.view">
        <field name="name">visa.vx.705.import.wizard.form</field>
        <field name="model">visa.vx.705.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import VX-705 Text File">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" required="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Upload a Visa VX-705 text report. Imported Sales Draft data will be saved permanently in the database.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import &amp; Save" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_visa_vx_705_import_wizard" model="ir.actions.act_window">
        <field name="name">Import VX-705 Text File</field>
        <field name="res_model">visa.vx.705.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

