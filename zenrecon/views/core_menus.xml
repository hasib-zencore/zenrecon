    </record>
    <record id="menu_bsr_report_210" model="ir.ui.menu">
        <field name="name">VSS-210 Details</field><field name="parent_id" ref="menu_bsr_reports_root"/><field name="sequence">50</field><field name="active" eval="False"/>
    </record>

