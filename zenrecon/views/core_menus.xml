              parent="menu_bsr_visa_settlement_processing"
              action="action_bsr_vss_exception" sequence="40" groups="base.group_user"/>

    <!-- Legacy report submenus stay inactive; reports are opened from their imported file. -->
    <record id="menu_bsr_report_110" model="ir.ui.menu">
        <field name="name">VSS-110 Details</field><field name="parent_id" ref="menu_bsr_reports_root"/><field name="sequence">10</field><field name="active" eval="False"/>
    </record>
    <record id="menu_bsr_report_120" model="ir.ui.menu">
        <field name="name">VSS-120 Details</field><field name="parent_id" ref="menu_bsr_reports_root"/><field name="sequence">20</field><field name="active" eval="False"/>
    </record>
    <record id="menu_bsr_report_130" model="ir.ui.menu">
