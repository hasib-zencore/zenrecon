<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One application shell; scheme-specific functions are grouped by purpose. -->
    <menuitem id="menu_bsr_root"
              name="Bank Reconciliation"
              action="action_bsr_vss_import"
              sequence="35"
              web_icon="zenrecon,static/description/icon.png"
              groups="base.group_user"/>

    <!-- Centralized intake. All source streams are collected from this page. -->
    <menuitem id="menu_zenrecon_data_intake" name="Data Intake"
              parent="menu_bsr_root" action="action_open_source_workspace"
              sequence="2" groups="base.group_user"/>

