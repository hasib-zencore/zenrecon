    <menuitem id="menu_bsr_visa_section" name="VISA" parent="menu_bsr_root"
              sequence="10" groups="base.group_user"/>

    <menuitem id="menu_bsr_visa_settlement_processing" name="Settlement Processing"
              parent="menu_bsr_visa_section" sequence="10" groups="base.group_user"/>
    <record id="menu_bsr_import_from_documents" model="ir.ui.menu">
        <field name="name">Upload VSS File</field>
        <field name="parent_id" ref="menu_bsr_visa_settlement_processing"/>
        <field name="action" ref="action_bsr_vss_import_document_wizard"/>
        <field name="sequence">10</field>
        <field name="active" eval="False"/>
    </record>
    <menuitem id="menu_bsr_vss_imports" name="VSS Import History"
              parent="menu_bsr_visa_settlement_processing"
              action="action_bsr_vss_import" sequence="20" groups="base.group_user"/>
