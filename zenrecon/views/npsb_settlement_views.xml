<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Upload Wizard (Popup)                                        -->
    <!-- ============================================================ -->

    <record id="view_npsb_settlement_upload_wizard_form" model="ir.ui.view">
        <field name="name">npsb.settlement.upload.wizard.form</field>
        <field name="model">npsb.settlement.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload NPSB Settlement PDF">
                <group>
                    <group>
                        <field name="pdf_file" filename="filename" widget="binary"
                                options="{'accepted_file_extensions': '.pdf'}"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_upload_and_process"
                            string="Upload &amp; Process"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npsb_settlement_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Settlement Report</field>
        <field name="res_model">npsb.settlement.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_npsb_settlement_upload_wizard_form"/>
    </record>

    <!-- ============================================================ -->
    <!-- Main Settlement Report Form & List                           -->
    <!-- ============================================================ -->

    <record id="view_npsb_settlement_report_form" model="ir.ui.view">
        <field name="name">npsb.settlement.report.form</field>
        <field name="model">npsb.settlement.report</field>
        <field name="arch" type="xml">
            <form string="NPSB Settlement Report" create="false">
                <header>
                    <button name="action_process_pdf"
                            string="Re-Process PDF"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'error'"
                            confirm="Re-process the uploaded PDF?"/>
                    <button name="action_reset_to_draft"
                            string="Reset"
                            type="object"
                            invisible="state == 'draft'"
                            confirm="This will delete all extracted lines. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_summary"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-alt">
                            <field name="summary_count" widget="statinfo" string="Summary"/>
                        </button>
                        <button name="action_view_details"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-table">
                            <field name="detail_count" widget="statinfo" string="Details"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="File">
                            <field name="pdf_file" filename="filename" widget="binary" readonly="1"/>
                            <field name="filename" invisible="1"/>
                            <field name="bank_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Metadata">
                            <field name="transaction_date"/>
                            <field name="settlement_date"/>
                            <field name="generated_by"/>
                            <field name="generation_datetime"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Summary Lines" name="summary">
                            <field name="summary_line_ids">
                                <list create="0" delete="0" edit="0"
                                      default_order="delivery_channel,issuer_acquirer desc,sequence">
                                    <field name="sequence" string="SL#"/>
                                    <field name="transaction_date" string="Transaction Business Date"/>
                                    <field name="settlement_date" string="Settlement Business Date"/>
                                    <field name="issuer_acquirer" string="Issuer/Acquirer"/>
                                    <field name="delivery_channel" string="Delivery Channel"/>
                                    <field name="trans_type" string="Trans Type"/>
                                    <field name="no_of_trans" string="No. of Trans" sum="Total"/>
                                    <field name="trans_amount" string="Trans Amount" sum="Total"/>
                                    <field name="fees_irf_amount" string="Fees/IRF" sum="Total"/>
                                    <field name="platform_fee" string="Platform Fee" sum="Total"/>
                                    <field name="net_amount" string="Net Amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Detail Lines" name="details">
                            <field name="detail_line_ids">
                                <list create="0" delete="0" edit="0"
                                      default_order="delivery_channel,counter_bank,issuer_acquirer desc,sequence">
                                    <field name="sequence" string="SL#"/>
                                    <field name="transaction_date" string="Transaction Business Date"/>
                                    <field name="settlement_date" string="Settlement Business Date"/>
                                    <field name="issuer_acquirer" string="Issuer/Acquirer"/>
                                    <field name="delivery_channel" string="Delivery Channel"/>
                                    <field name="counter_bank" string="Counter Bank"/>
                                    <field name="trans_type" string="Trans Type"/>
                                    <field name="no_of_trans" string="No. of Trans" sum="Total"/>
                                    <field name="trans_amount" string="Trans Amount" sum="Total"/>
                                    <field name="fees_irf_amount" string="Fees/IRF" sum="Total"/>
                                    <field name="platform_fee" string="Platform Fee" sum="Total"/>
                                    <field name="net_amount" string="Net Amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Processing Log" name="log">
                            <field name="processing_log" widget="text" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_npsb_settlement_report_list" model="ir.ui.view">
        <field name="name">npsb.settlement.report.list</field>
        <field name="model">npsb.settlement.report</field>
        <field name="arch" type="xml">
            
            
            <list string="NPSB Settlement Reports" create="false">
                <field name="name"/>
                <field name="bank_name"/>
                <field name="transaction_date"/>
                <field name="settlement_date"/>
                <field name="generated_by"/>
                <field name="summary_count"/>
                <field name="detail_count"/>
                <field name="state" widget="badge"/>
            </list>


        </field>
    </record>

    <record id="view_npsb_settlement_report_search" model="ir.ui.view">
        <field name="name">npsb.settlement.report.search</field>
        <field name="model">npsb.settlement.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="bank_name"/>
                <field name="transaction_date"/>
                <field name="settlement_date"/>
                <field name="state"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <filter name="filter_error" string="Error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="group_settlement_date" string="Settlement Date" context="{'group_by': 'settlement_date'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Summary Line Views                                           -->
    <!-- ============================================================ -->

    <record id="view_npsb_settlement_summary_line_list" model="ir.ui.view">
        <field name="name">npsb.settlement.summary.line.list</field>
        <field name="model">npsb.settlement.summary.line</field>
        <field name="arch" type="xml">
            <list string="Summary Settlement Position"
                  create="0" delete="0" edit="0"
                  default_order="delivery_channel,issuer_acquirer desc,sequence">
                <field name="sequence" string="SL#"/>
                <field name="transaction_date" string="Transaction Business Date"/>
                <field name="settlement_date" string="Settlement Business Date"/>
                <field name="issuer_acquirer" string="Issuer/Acquirer"/>
                <field name="delivery_channel" string="Delivery Channel"/>
                <field name="trans_type" string="Trans Type"/>
                <field name="no_of_trans" string="No. of Trans" sum="Total Trans"/>
                <field name="trans_amount" string="Trans Amount" sum="Total Amount"/>
                <field name="fees_irf_amount" string="Fees/IRF" sum="Total"/>
                <field name="platform_fee" string="Platform Fee" sum="Total"/>
                <field name="net_amount" string="Net Amount" sum="Total"/>
                <field name="report_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_npsb_settlement_summary_line_form" model="ir.ui.view">
        <field name="name">npsb.settlement.summary.line.form</field>
        <field name="model">npsb.settlement.summary.line</field>
        <field name="arch" type="xml">
            <form string="Summary Line" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="report_id"/>
                            <field name="sequence" string="SL#"/>
                            <field name="issuer_acquirer"/>
                            <field name="delivery_channel"/>
                            <field name="trans_type"/>
                        </group>
                        <group>
                            <field name="transaction_date"/>
                            <field name="settlement_date"/>
                            <field name="bank_name"/>
                            <field name="no_of_trans"/>
                            <field name="trans_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_npsb_settlement_summary_line_search" model="ir.ui.view">
        <field name="name">npsb.settlement.summary.line.search</field>
        <field name="model">npsb.settlement.summary.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="issuer_acquirer"/>
                <field name="delivery_channel"/>
                <field name="trans_type"/>
                <field name="report_id"/>
                <separator/>
                <filter name="filter_issuing" string="Issuing"
                        domain="[('issuer_acquirer', '=', 'Issuing')]"/>
                <filter name="filter_acquiring" string="Acquiring/Beneficiary"
                        domain="[('issuer_acquirer', '=', 'Acquiring/Beneficiary')]"/>
                <separator/>
                <filter name="filter_atm" string="ATM" domain="[('delivery_channel', '=', 'ATM')]"/>
                <filter name="filter_pos" string="POS" domain="[('delivery_channel', '=', 'POS')]"/>
                <filter name="filter_ib"  string="IB"  domain="[('delivery_channel', '=', 'IB')]"/>
                <filter name="filter_mfs" string="MFS" domain="[('delivery_channel', '=', 'MFS')]"/>
                <filter name="filter_qr"  string="QR"  domain="[('delivery_channel', '=', 'QR')]"/>
                <separator/>
                <filter name="group_issuer" string="Issuer/Acquirer"
                        context="{'group_by': 'issuer_acquirer'}"/>
                <filter name="group_channel" string="Delivery Channel"
                        context="{'group_by': 'delivery_channel'}"/>
                <filter name="group_trans_type" string="Trans Type"
                        context="{'group_by': 'trans_type'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Detail Line Views                                            -->
    <!-- ============================================================ -->

    <record id="view_npsb_settlement_detail_line_list" model="ir.ui.view">
        <field name="name">npsb.settlement.detail.line.list</field>
        <field name="model">npsb.settlement.detail.line</field>
        <field name="arch" type="xml">
            <list string="Detail Settlement Position"
                  create="0" delete="0" edit="0"
                  default_order="delivery_channel,counter_bank,issuer_acquirer desc,sequence">
                <field name="sequence" string="SL#"/>
                <field name="transaction_date" string="Transaction Business Date"/>
                <field name="settlement_date" string="Settlement Business Date"/>
                <field name="issuer_acquirer" string="Issuer/Acquirer"/>
                <field name="delivery_channel" string="Delivery Channel"/>
                <field name="counter_bank" string="Counter Bank"/>
                <field name="trans_type" string="Trans Type"/>
                <field name="no_of_trans" string="No. of Trans" sum="Total Trans"/>
                <field name="trans_amount" string="Trans Amount" sum="Total Amount"/>
                <field name="fees_irf_amount" string="Fees/IRF" sum="Total"/>
                <field name="platform_fee" string="Platform Fee" sum="Total"/>
                <field name="net_amount" string="Net Amount" sum="Total"/>
                <field name="report_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_npsb_settlement_detail_line_form" model="ir.ui.view">
        <field name="name">npsb.settlement.detail.line.form</field>
        <field name="model">npsb.settlement.detail.line</field>
        <field name="arch" type="xml">
            <form string="Detail Line" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="report_id"/>
                            <field name="sequence" string="SL#"/>
                            <field name="issuer_acquirer"/>
                            <field name="delivery_channel"/>
                            <field name="counter_bank"/>
                            <field name="trans_type"/>
                        </group>
                        <group>
                            <field name="transaction_date"/>
                            <field name="settlement_date"/>
                            <field name="bank_name"/>
                            <field name="no_of_trans"/>
                            <field name="trans_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_npsb_settlement_detail_line_search" model="ir.ui.view">
        <field name="name">npsb.settlement.detail.line.search</field>
        <field name="model">npsb.settlement.detail.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="issuer_acquirer"/>
                <field name="delivery_channel"/>
                <field name="counter_bank"/>
                <field name="trans_type"/>
                <field name="report_id"/>
                <separator/>
                <filter name="filter_issuing" string="Issuing"
                        domain="[('issuer_acquirer', '=', 'Issuing')]"/>
                <filter name="filter_acquiring" string="Acquiring/Beneficiary"
                        domain="[('issuer_acquirer', '=', 'Acquiring/Beneficiary')]"/>
                <separator/>
                <filter name="filter_atm" string="ATM" domain="[('delivery_channel', '=', 'ATM')]"/>
                <filter name="filter_pos" string="POS" domain="[('delivery_channel', '=', 'POS')]"/>
                <filter name="filter_ib"  string="IB"  domain="[('delivery_channel', '=', 'IB')]"/>
                <filter name="filter_mfs" string="MFS" domain="[('delivery_channel', '=', 'MFS')]"/>
                <filter name="filter_qr"  string="QR"  domain="[('delivery_channel', '=', 'QR')]"/>
                <separator/>
                <filter name="group_issuer" string="Issuer/Acquirer"
                        context="{'group_by': 'issuer_acquirer'}"/>
                <filter name="group_channel" string="Delivery Channel"
                        context="{'group_by': 'delivery_channel'}"/>
                <filter name="group_bank" string="Counter Bank"
                        context="{'group_by': 'counter_bank'}"/>
                <filter name="group_trans_type" string="Trans Type"
                        context="{'group_by': 'trans_type'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Actions                                                      -->
    <!-- ============================================================ -->

    <record id="action_npsb_settlement_report" model="ir.actions.act_window">
        <field name="name">Settlement Reports</field>
        <field name="res_model">npsb.settlement.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_npsb_settlement_report_search"/>
        <field name="context" eval="{'create': False}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No settlement reports yet
            </p>
            <p>
                Click <strong>Upload Settlement PDF</strong> above to upload and process a PDF.
            </p>
        </field>
    </record>

    <record id="action_npsb_settlement_summary_line" model="ir.actions.act_window">
        <field name="name">Settlement Summary</field>
        <field name="res_model">npsb.settlement.summary.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_npsb_settlement_summary_line_search"/>
    </record>

    <record id="action_npsb_settlement_detail_line" model="ir.actions.act_window">
        <field name="name">Settlement Details</field>
        <field name="res_model">npsb.settlement.detail.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_npsb_settlement_detail_line_search"/>
    </record>

    <record id="seq_npsb_settlement_report" model="ir.sequence">
        <field name="name">NPSB Settlement Report</field>
        <field name="code">npsb.settlement.report</field>
        <field name="prefix">NPSB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
