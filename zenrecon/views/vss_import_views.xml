<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bsr_vss_import_search" model="ir.ui.view">
        <field name="name">bsr.vss.import.search</field>
        <field name="model">bsr.vss.import</field>
        <field name="arch" type="xml">
            <search string="Search VSS Imports">
                <field name="name"/>
                <field name="file_name"/>
                <field name="attachment_id" string="Source File"/>
                <field name="file_hash"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="With Exceptions" name="partial" domain="[('state', '=', 'partial')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Created Month" name="group_create_month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bsr_vss_import_list" model="ir.ui.view">
        <field name="name">bsr.vss.import.list</field>
        <field name="model">bsr.vss.import</field>
        <field name="arch" type="xml">
            <list string="VSS Imports" class="o_bsr_vss_import_list" create="false" delete="false">
                <field name="name"/>
                <field name="file_name"/>
                <field name="attachment_id" string="Source File" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'failed'"/>
                <field name="vss_110_line_count" string="VSS-110 Rows"/>
                <field name="vss_120_line_count" string="VSS-120 Rows"/>
                <field name="vss_130_line_count" string="VSS-130 Rows"/>
                <field name="vss_140_line_count" string="VSS-140 Rows"/>
                <field name="vss_210_line_count" string="VSS-210 Rows"/>
                <field name="no_data_block_count" string="NO DATA Skipped" optional="show"/>
                <field name="exception_count" string="Parsing Exceptions" optional="show"/>
                <field name="processing_completed_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bsr_vss_import_form" model="ir.ui.view">
        <field name="name">bsr.vss.import.form</field>
        <field name="model">bsr.vss.import</field>
        <field name="arch" type="xml">
            <form string="VSS Import" class="o_bsr_vss_import_form" create="false" delete="false">
                <header>
                        <button name="action_process" string="Process / Rebuild 5 Reports" type="object" icon="fa-play"
                            class="btn-primary" invisible="state == 'processing'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,completed,partial,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_vss_110" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="vss_110_line_count" widget="statinfo" string="VSS-110"/>
                        </button>
                        <button name="action_open_vss_120" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="vss_120_line_count" widget="statinfo" string="VSS-120"/>
                        </button>
                        <button name="action_open_vss_130" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="vss_130_line_count" widget="statinfo" string="VSS-130"/>
                        </button>
                        <button name="action_open_vss_140" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="vss_140_line_count" widget="statinfo" string="VSS-140"/>
                        </button>
                        <button name="action_open_vss_210" type="object" class="oe_stat_button" icon="fa-table">
                            <field name="vss_210_line_count" widget="statinfo" string="VSS-210"/>
                        </button>
                        <button name="action_open_exceptions" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="exception_count == 0">
                            <field name="exception_count" widget="statinfo" string="Parsing Exceptions"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Source File">
                            <field name="attachment_id" readonly="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="file_name"/>
                            <field name="file_size"/>
                            <field name="file_hash"/>
                        </group>
                        <group string="Processing">
                            <field name="processing_started_at"/>
                            <field name="processing_completed_at"/>
                            <field name="create_uid" string="Imported By"/>
                            <field name="create_date" string="Imported At"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <separator string="Five Consolidated Reports for This File"/>
                    <group col="5">
                        <field name="vss_110_line_count" string="VSS-110 Rows"/>
                        <field name="vss_120_line_count" string="VSS-120 Rows"/>
                        <field name="vss_130_line_count" string="VSS-130 Rows"/>
                        <field name="vss_140_line_count" string="VSS-140 Rows"/>
                        <field name="vss_210_line_count" string="VSS-210 Rows"/>
                    </group>

                    <separator string="Source Scan Audit"/>
                    <group>
                        <group>
                            <field name="source_block_count" string="Target Source Blocks Found"/>
                            <field name="data_block_count" string="Data Blocks Appended"/>
                            <field name="no_data_block_count" string="NO DATA Blocks Skipped"/>
                            <field name="error_block_count" string="Block Errors"/>
                        </group>
                        <group>
                            <field name="vss_110_source_count" string="VSS-110 Source Blocks"/>
                            <field name="vss_120_source_count" string="VSS-120 Source Blocks"/>
                            <field name="vss_130_source_count" string="VSS-130 Source Blocks"/>
                            <field name="vss_140_source_count" string="VSS-140 Source Blocks"/>
                            <field name="vss_210_source_count" string="VSS-210 Source Blocks"/>
                        </group>
                    </group>

                    <field name="processing_message" nolabel="1" readonly="1"/>

                    <div class="alert alert-info" role="alert">
                        Each button above opens one consolidated report table for this source TXT file only.
                        Explicit "NO DATA FOR THIS REPORT" blocks are skipped and do not create report rows.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bsr_vss_import" model="ir.actions.act_window">
        <field name="name">VSS Import History</field>
        <field name="res_model">bsr.vss.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bsr_vss_import_search"/>
    </record>

    <record id="action_bsr_vss_report_sets" model="ir.actions.act_window">
        <field name="name">VSS Settlement Reports</field>
        <field name="res_model">bsr.vss.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bsr_vss_import_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import a Visa settlement TXT file first.</p>
            <p>Open an import to access its five consolidated VSS reports.</p>
        </field>
    </record>
</odoo>
