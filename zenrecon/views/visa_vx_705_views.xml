<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visa_vx_705_list" model="ir.ui.view">
        <field name="name">visa.vx.705.list</field>
        <field name="model">visa.vx.705</field>
        <field name="arch" type="xml">
            <list string="VX-705 Sales Drafts"
                decoration-muted="not active">

                <field name="report_code"/>
                <field name="report_type"/>
                <field name="report_name"/>
                <field name="system_date"/>
                <field name="release"/>
                <field name="cpd"/>
                <field name="bank_name"/>
                <field name="center"/>
                <field name="run_number"/>
                <field name="page"/>
                <field name="draft_type"/>
                <field name="data_section"/>
                <field name="account_number"/>
                <field name="floor_limit_indicator"/>
                <field name="crb_exception_file_indicator"/>
                <field name="acquirer_reference_number"/>
                <field name="acquirer_business_id"/>
                <field name="purchase_date"/>
                <field name="destination_amount" sum="Total Destination"/>
                <field name="destination_currency_code"/>
                <field name="destination_currency_id"/>
                <field name="source_amount" sum="Total Source"/>
                <field name="source_currency_code"/>
                <field name="source_currency_id"/>
                <field name="merchant_name"/>
                <field name="merchant_city"/>
                <field name="merchant_country_code"/>
                <field name="merchant_category_code"/>
                <field name="merchant_zip_code"/>
                <field name="merchant_state_province_code"/>
                <field name="requested_payment_service"/>
                <field name="number_of_payment_forms"/>
                <field name="usage_code"/>
                <field name="chargeback_reason_code"/>
                <field name="settlement_flag"/>
                <field name="auth_characteristics_indicator"/>
                <field name="authorization_code"/>
                <field name="pos_terminal_capability"/>
                <field name="cardholder_id_method"/>
                <field name="collection_only_flag"/>
                <field name="pos_entry_mode"/>
                <field name="central_processing_date"/>
                <field name="reimbursement_attribute"/>

                <!-- =====================================================
                    ADDITIONAL DATA
                ====================================================== -->
                <field name="business_format_code"/>
                <field name="token_assurance_method"/>
                <field name="rate_table_id"/>
                <field name="scheme_identifier"/>
                <field name="reserved_data"/>
                <field name="documentation_indicator"/>
                <field name="member_message_text"/>
                <field name="special_condition_indicator"/>
                <field name="fee_program_indicator"/>
                <field name="issuer_charge"/>
                <field name="pfx_applied_indicator"/>
                <field name="card_acceptor_id"/>
                <field name="terminal_id"/>

                <field name="national_reimbursement_fee"
                    sum="Total National Reimbursement Fee"/>

                <field name="mail_phone_ecommerce_payment_indicator"/>
                <field name="special_chargeback_indicator"/>
                <field name="conversion_date"/>
                <field name="additional_token_response"/>
                <field name="acceptance_terminal_indicator"/>
                <field name="prepaid_card_indicator"/>
                <field name="service_development_field"/>
                <field name="avs_response_code"/>
                <field name="authorization_source_code"/>
                <field name="purchase_id_format"/>
                <field name="account_selection"/>
                <field name="installment_payment_count"/>
                <field name="purchase_identifier"/>

                <field name="cashback"
                    sum="Total Cashback"/>

                <field name="chip_condition_code"/>
                <field name="pos_environment"/>

                <!-- =====================================================
                    PAYMENT SERVICE DATA
                ====================================================== -->
                <field name="transaction_identifier"/>

                <field name="authorized_amount"
                    sum="Total Authorized"/>

                <field name="auth_currency_code"/>
                <field name="auth_currency_id"/>
                <field name="ecommerce_goods_indicator"/>
                <field name="merchant_verification_value"/>

                <field name="interchange_fee_amount"
                    sum="Total Interchange Fee"/>

                <field name="interchange_fee_sign"/>
                <field name="authorization_response_code"/>
                <field name="validation_code"/>
                <field name="excluded_transaction_id_reason"/>
                <field name="crs_processing_code"/>
                <field name="chargeback_rights_indicator"/>
                <field name="multiple_clearing_sequence_number"/>
                <field name="multiple_clearing_sequence_count"/>
                <field name="market_specific_authorization_data"/>

                <field name="total_authorized_amount"
                    sum="Total Authorized Amount"/>

                <field name="information_indicator"/>
                <field name="merchant_telephone_number"/>
                <field name="additional_data_indicator"/>
                <field name="merchant_volume_indicator"/>
                <field name="source_to_base_currency_exchange_rate"/>
                <field name="base_to_destination_currency_exchange_rate"/>

                <field name="optional_issuer_isa_amount"
                    sum="Total Optional Issuer ISA"/>

                <field name="product_id_code"/>
                <field name="program_id"/>
                <field name="dynamic_currency_conversion_indicator"/>
                <field name="account_type_identification"/>
                <field name="spend_qualified_indicator"/>
                <field name="pan_token"/>
                <field name="account_funding_source"/>
                <field name="cvv2_result_code"/>
                
                <field name="active" column_invisible="1"/>

            </list>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_visa_vx_705_form" model="ir.ui.view">
        <field name="name">visa.vx.705.form</field>
        <field name="model">visa.vx.705</field>
        <field name="arch" type="xml">
            <form string="VX-705 Sales Draft">
                <header>
                    <button name="get_data" type="object"
                            string="Show in Terminal" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="account_number" placeholder="Account Number"/>
                        </h1>
                        <h3>
                            <field name="merchant_name" placeholder="Merchant Name"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Draft Info">
                            <field name="draft_type"/>
                            <field name="data_section"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Report Header">
                            <field name="report_code"/>
                            <field name="report_type"/>
                            <field name="report_name"/>
                            <field name="system_date"/>
                            <field name="release"/>
                            <field name="cpd"/>
                            <field name="bank_name"/>
                            <field name="center"/>
                            <field name="run_number"/>
                            <field name="page"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Required Data">
                            <group>
                                <group>
                                    <field name="floor_limit_indicator"/>
                                    <field name="crb_exception_file_indicator"/>
                                    <field name="acquirer_reference_number"/>
                                    <field name="acquirer_business_id"/>
                                    <field name="purchase_date"/>
                                    <field name="destination_amount"/>
                                    <field name="destination_currency_code"/>
                                    <field name="destination_currency_id"/>
                                    <field name="source_amount"/>
                                    <field name="source_currency_code"/>
                                    <field name="source_currency_id"/>
                                    <field name="merchant_city"/>
                                    <field name="merchant_country_code"/>
                                    <field name="merchant_category_code"/>
                                    <field name="merchant_zip_code"/>
                                    <field name="merchant_state_province_code"/>
                                </group>
                                <group>
                                    <field name="requested_payment_service"/>
                                    <field name="number_of_payment_forms"/>
                                    <field name="usage_code"/>
                                    <field name="chargeback_reason_code"/>
                                    <field name="settlement_flag"/>
                                    <field name="auth_characteristics_indicator"/>
                                    <field name="authorization_code"/>
                                    <field name="pos_terminal_capability"/>
                                    <field name="cardholder_id_method"/>
                                    <field name="collection_only_flag"/>
                                    <field name="pos_entry_mode"/>
                                    <field name="central_processing_date"/>
                                    <field name="reimbursement_attribute"/>
                                </group>
                            </group>
                        </page>

                        <page string="Additional Data">
                            <group>
                                <group>
                                    <field name="business_format_code"/>
                                    <field name="token_assurance_method"/>
                                    <field name="rate_table_id"/>
                                    <field name="scheme_identifier"/>
                                    <field name="reserved_data"/>
                                    <field name="documentation_indicator"/>
                                    <field name="member_message_text"/>
                                    <field name="special_condition_indicator"/>
                                    <field name="fee_program_indicator"/>
                                    <field name="issuer_charge"/>
                                    <field name="pfx_applied_indicator"/>
                                    <field name="card_acceptor_id"/>
                                    <field name="terminal_id"/>
                                    <field name="national_reimbursement_fee"/>
                                </group>
                                <group>
                                    <field name="mail_phone_ecommerce_payment_indicator"/>
                                    <field name="special_chargeback_indicator"/>
                                    <field name="conversion_date"/>
                                    <field name="additional_token_response"/>
                                    <field name="acceptance_terminal_indicator"/>
                                    <field name="prepaid_card_indicator"/>
                                    <field name="service_development_field"/>
                                    <field name="avs_response_code"/>
                                    <field name="authorization_source_code"/>
                                    <field name="purchase_id_format"/>
                                    <field name="account_selection"/>
                                    <field name="installment_payment_count"/>
                                    <field name="purchase_identifier"/>
                                    <field name="cashback"/>
                                    <field name="chip_condition_code"/>
                                    <field name="pos_environment"/>
                                </group>
                            </group>
                        </page>

                        <page string="Payment Service Data">
                            <group>
                                <group>
                                    <field name="transaction_identifier"/>
                                    <field name="authorized_amount"/>
                                    <field name="auth_currency_code"/>
                                    <field name="auth_currency_id"/>
                                    <field name="ecommerce_goods_indicator"/>
                                    <field name="merchant_verification_value"/>
                                    <field name="interchange_fee_amount"/>
                                    <field name="interchange_fee_sign"/>
                                    <field name="authorization_response_code"/>
                                    <field name="validation_code"/>
                                    <field name="excluded_transaction_id_reason"/>
                                    <field name="crs_processing_code"/>
                                    <field name="chargeback_rights_indicator"/>
                                    <field name="multiple_clearing_sequence_number"/>
                                    <field name="multiple_clearing_sequence_count"/>
                                    <field name="market_specific_authorization_data"/>
                                </group>
                                <group>
                                    <field name="total_authorized_amount"/>
                                    <field name="information_indicator"/>
                                    <field name="merchant_telephone_number"/>
                                    <field name="additional_data_indicator"/>
                                    <field name="merchant_volume_indicator"/>
                                    <field name="source_to_base_currency_exchange_rate"/>
                                    <field name="base_to_destination_currency_exchange_rate"/>
                                    <field name="optional_issuer_isa_amount"/>
                                    <field name="product_id_code"/>
                                    <field name="program_id"/>
                                    <field name="dynamic_currency_conversion_indicator"/>
                                    <field name="account_type_identification"/>
                                    <field name="spend_qualified_indicator"/>
                                    <field name="pan_token"/>
                                    <field name="account_funding_source"/>
                                    <field name="cvv2_result_code"/>
                                </group>
                            </group>
                        </page>

                        <page string="System Info">
                            <group>
                                <field name="source_file_name"/>
                                <field name="source_line_number"/>
                                <field name="imported_at"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    
    <!-- ================= ACTION ================= -->
    <record id="action_visa_vx_705" model="ir.actions.act_window">
        <field name="name">VX-705 Sales Drafts</field>
        <field name="res_model">visa.vx.705</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No VX-705 sales draft records yet.
            </p>
            <p>
                Records are created by importing a Visa VX-705
                (Incoming Interchange Sales Drafts) report file.
            </p>
        </field>
    </record>

</odoo>
