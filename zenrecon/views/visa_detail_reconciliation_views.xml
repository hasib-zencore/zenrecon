<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account classification -->
    <record id="view_visa_detail_account_type_list" model="ir.ui.view">
        <field name="name">visa.detail.account.type.list</field>
        <field name="model">visa.detail.account.type</field>
        <field name="arch" type="xml">
            <list string="VISA Account Types" editable="bottom">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_visa_detail_account_type_form" model="ir.ui.view">
        <field name="name">visa.detail.account.type.form</field>
        <field name="model">visa.detail.account.type</field>
        <field name="arch" type="xml">
            <form string="VISA Account Type">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Gold Card"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <separator string="Account-number prefixes"/>
                    <field name="rule_ids" context="{'default_company_id': company_id}">
                        <list editable="bottom">
                            <field name="prefix"/>
                            <field name="prefix_length" readonly="1"/>
                            <field name="priority" optional="hide"/>
                            <field name="valid_from" optional="hide"/>
                            <field name="valid_to" optional="hide"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_account_type" model="ir.actions.act_window">
        <field name="name">Account Types</field>
        <field name="res_model">visa.detail.account.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_visa_detail_account_rule_list" model="ir.ui.view">
        <field name="name">visa.detail.account.rule.list</field>
        <field name="model">visa.detail.account.rule</field>
        <field name="arch" type="xml">
            <list string="Account Type Rules" decoration-muted="not active">
                <header>
                    <button name="action_apply_to_existing" type="object" string="Apply Rules to Existing VISA Data"
                            class="btn-primary" display="always"/>
                </header>
                <field name="prefix"/>
                <field name="prefix_length"/>
                <field name="account_type_id"/>
                <field name="priority" optional="show"/>
                <field name="valid_from" optional="hide"/>
                <field name="valid_to" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_visa_detail_account_rule_form" model="ir.ui.view">
        <field name="name">visa.detail.account.rule.form</field>
        <field name="model">visa.detail.account.rule</field>
        <field name="arch" type="xml">
            <form string="Account Type Rule">
                <header><button name="action_apply_to_existing" type="object" string="Apply Rules" class="btn-primary"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="prefix" placeholder="Beginning of account number"/>
                            <field name="prefix_normalized" readonly="1"/>
                            <field name="account_type_id" domain="[('company_id', '=', company_id)]"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_account_rule" model="ir.actions.act_window">
        <field name="name">Account Classification Rules</field>
        <field name="res_model">visa.detail.account.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- CMS/CBS source imports -->
    <record id="action_visa_detail_cms_upload" model="ir.actions.act_window">
        <field name="name">Upload CMS File</field>
        <field name="res_model">visa.detail.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_source': 'cms'}</field>
    </record>
    <record id="action_visa_detail_cbs_upload" model="ir.actions.act_window">
        <field name="name">Upload CBS File</field>
        <field name="res_model">visa.detail.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_source': 'cbs'}</field>
    </record>
    <record id="view_visa_detail_import_list" model="ir.ui.view">
        <field name="name">visa.detail.import.list</field>
        <field name="model">visa.detail.import</field>
        <field name="arch" type="xml">
            <list string="CMS/CBS Imports" create="0" decoration-success="state == 'processed'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="source" widget="badge"/>
                <field name="business_date"/>
                <field name="filename"/>
                <field name="file_format" optional="show"/>
                <field name="column_count"/>
                <field name="row_count"/>
                <field name="state" widget="badge"/>
                <field name="imported_at"/>
                <field name="imported_by" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_visa_detail_import_form" model="ir.ui.view">
        <field name="name">visa.detail.import.form</field>
        <field name="model">visa.detail.import</field>
        <field name="arch" type="xml">
            <form string="CMS/CBS Import" create="0">
                <header>
                    <button name="action_process" type="object" string="Process File" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,error"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="source" readonly="state != 'draft'"/>
                            <field name="business_date" readonly="state != 'draft'"/>
                            <field name="filename" readonly="1"/>
                            <field name="file" filename="filename" readonly="1"/>
                        </group>
                        <group>
                            <field name="file_format"/>
                            <field name="file_size"/>
                            <field name="column_count"/>
                            <field name="row_count"/>
                            <field name="imported_at"/>
                            <field name="imported_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message" class="text-danger"/>
                    <notebook>
                        <page string="Detected Columns">
                            <field name="column_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence" string="#"/>
                                    <field name="source_name"/>
                                    <field name="technical_name"/>
                                    <field name="sample_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Imported Rows">
                            <field name="row_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="row_number" string="Source Row"/>
                                    <field name="preview"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_imports" model="ir.actions.act_window">
        <field name="name">CMS/CBS Imports</field>
        <field name="res_model">visa.detail.import</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_visa_detail_cms_imports" model="ir.actions.act_window">
        <field name="name">CMS Import History</field>
        <field name="res_model">visa.detail.import</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('source', '=', 'cms')]</field>
    </record>
    <record id="action_visa_detail_cbs_imports" model="ir.actions.act_window">
        <field name="name">CBS Import History</field>
        <field name="res_model">visa.detail.import</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('source', '=', 'cbs')]</field>
    </record>

    <!-- Stable mapping profile -->
    <record id="view_visa_detail_match_profile_list" model="ir.ui.view">
        <field name="name">visa.detail.match.profile.list</field>
        <field name="model">visa.detail.match.profile</field>
        <field name="arch" type="xml">
            <list string="One-to-One Matching Profiles" decoration-muted="not active">
                <field name="name"/>
                <field name="retention_months"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_visa_detail_match_profile_form" model="ir.ui.view">
        <field name="name">visa.detail.match.profile.form</field>
        <field name="model">visa.detail.match.profile</field>
        <field name="arch" type="xml">
            <form string="One-to-One Matching Profile">
                <header>
                    <button name="action_refresh_columns" type="object" string="Refresh Available Columns" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Daily VISA Reconciliation"/></h1></div>
                    <group>
                        <field name="active"/>
                        <field name="retention_months"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Configure once and reuse daily. CMS/CBS dropdowns are populated automatically from uploaded file headers.
                    </div>
                    <field name="line_ids" context="{'default_company_id': company_id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="visa_field_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="cms_field_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="cbs_field_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="normalizer"/>
                            <field name="required" widget="boolean_toggle"/>
                            <field name="company_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_match_profile" model="ir.actions.act_window">
        <field name="name">Source Matching Profiles</field>
        <field name="res_model">visa.detail.match.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Runs and result ledger -->
    <record id="view_visa_detail_run_list" model="ir.ui.view">
        <field name="name">visa.detail.reconciliation.run.list</field>
        <field name="model">visa.detail.reconciliation.run</field>
        <field name="arch" type="xml">
            <list string="VISA One-to-One Runs" decoration-success="state == 'completed'" decoration-danger="state == 'exception'">
                <field name="name"/>
                <field name="business_date"/>
                <field name="profile_id"/>
                <field name="visa_count"/>
                <field name="cms_count"/>
                <field name="cbs_count"/>
                <field name="matched_count"/>
                <field name="unmatched_count"/>
                <field name="state" widget="badge"/>
                <field name="processed_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_visa_detail_run_form" model="ir.ui.view">
        <field name="name">visa.detail.reconciliation.run.form</field>
        <field name="model">visa.detail.reconciliation.run</field>
        <field name="arch" type="xml">
            <form string="VISA One-to-One Reconciliation">
                <header>
                    <button name="action_reconcile" type="object" string="Process &amp; Reconcile" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,completed,exception"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="business_date" readonly="state != 'draft'"/>
                            <field name="profile_id" readonly="state != 'draft'"/>
                            <field name="cms_import_id" readonly="state != 'draft'"/>
                            <field name="cbs_import_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="visa_count"/>
                            <field name="cms_count"/>
                            <field name="cbs_count"/>
                            <field name="match_group_count"/>
                            <field name="matched_count"/>
                            <field name="unmatched_count"/>
                            <field name="processed_at"/>
                            <field name="processed_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="item_ids" nolabel="1">
                        <list create="0" edit="0" delete="0" decoration-success="status == 'matched'" decoration-warning="status == 'unmatched'">
                            <field name="name" string="Result ID"/>
                            <field name="source_label"/>
                            <field name="source_row_number"/>
                            <field name="account_type_id"/>
                            <field name="status" widget="badge"/>
                            <field name="matched_with"/>
                            <field name="match_group_id" string="Match ID"/>
                            <field name="unmatched_reason" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_runs" model="ir.actions.act_window">
        <field name="name">Reconciliation Runs</field>
        <field name="res_model">visa.detail.reconciliation.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_visa_detail_item_search" model="ir.ui.view">
        <field name="name">visa.detail.reconciliation.item.search</field>
        <field name="model">visa.detail.reconciliation.item</field>
        <field name="arch" type="xml">
            <search string="Reconciliation Results">
                <field name="name"/>
                <field name="business_date"/>
                <field name="source_label"/>
                <field name="match_group_id"/>
                <field name="account_type_id"/>
                <filter name="matched" string="Matched" domain="[('status', '=', 'matched')]"/>
                <filter name="unmatched" string="Unmatched" domain="[('status', '=', 'unmatched')]"/>
                <separator/>
                <filter name="group_source" string="Source" context="{'group_by': 'source_label'}"/>
                <filter name="group_date" string="Business Date" context="{'group_by': 'business_date'}"/>
                <filter name="group_type" string="Account Type" context="{'group_by': 'account_type_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_visa_detail_item_list" model="ir.ui.view">
        <field name="name">visa.detail.reconciliation.item.list</field>
        <field name="model">visa.detail.reconciliation.item</field>
        <field name="arch" type="xml">
            <list string="Reconciliation Results" create="0" edit="0" delete="0"
                  decoration-success="status == 'matched'" decoration-warning="status == 'unmatched'">
                <field name="name" string="Result ID"/>
                <field name="business_date"/>
                <field name="source_label"/>
                <field name="source_row_number" string="Source Row"/>
                <field name="source_reference" optional="show"/>
                <field name="account_type_id"/>
                <field name="status" widget="badge"/>
                <field name="matched_with"/>
                <field name="match_group_id" string="Match ID"/>
                <field name="unmatched_reason" optional="show"/>
                <field name="run_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_visa_detail_item_form" model="ir.ui.view">
        <field name="name">visa.detail.reconciliation.item.form</field>
        <field name="model">visa.detail.reconciliation.item</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Result" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="business_date"/>
                            <field name="source_label"/>
                            <field name="visa_report_type" invisible="source != 'visa'"/>
                            <field name="source_row_number"/>
                            <field name="source_reference"/>
                            <field name="account_type_id"/>
                        </group>
                        <group>
                            <field name="status" widget="badge"/>
                            <field name="match_group_id" string="Match ID"/>
                            <field name="matched_with"/>
                            <field name="matched_at"/>
                            <field name="unmatched_reason"/>
                            <field name="run_id"/>
                            <field name="profile_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_matched" model="ir.actions.act_window">
        <field name="name">Matched Transactions</field>
        <field name="res_model">visa.detail.reconciliation.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'matched')]</field>
        <field name="search_view_id" ref="view_visa_detail_item_search"/>
    </record>
    <record id="action_visa_detail_unmatched" model="ir.actions.act_window">
        <field name="name">Active Unmatched Transactions</field>
        <field name="res_model">visa.detail.reconciliation.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'unmatched')]</field>
        <field name="search_view_id" ref="view_visa_detail_item_search"/>
    </record>

    <record id="view_visa_detail_archive_list" model="ir.ui.view">
        <field name="name">visa.detail.reconciliation.archive.list</field>
        <field name="model">visa.detail.reconciliation.archive</field>
        <field name="arch" type="xml">
            <list string="Archived Unmatched Transactions" create="0" edit="0" delete="0">
                <field name="original_name" string="Original Result ID"/>
                <field name="business_date"/>
                <field name="source_label"/>
                <field name="visa_report_type" optional="show"/>
                <field name="source_row_number"/>
                <field name="source_reference"/>
                <field name="account_type_name"/>
                <field name="unmatched_reason"/>
                <field name="archived_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_visa_detail_archive" model="ir.actions.act_window">
        <field name="name">Archived Unmatched Transactions</field>
        <field name="res_model">visa.detail.reconciliation.archive</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Upload wizards -->
    <record id="view_visa_detail_import_wizard_form" model="ir.ui.view">
        <field name="name">visa.detail.import.wizard.form</field>
        <field name="model">visa.detail.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Daily Source File">
                <group>
                    <field name="source" readonly="1"/>
                    <field name="business_date"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload &amp; Process" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_visa_detail_daily_wizard_form" model="ir.ui.view">
        <field name="name">visa.detail.daily.wizard.form</field>
        <field name="model">visa.detail.daily.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily VISA One-to-One Reconciliation">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Export the day's VISA, CMS, and CBS files from <strong>Data Intake</strong> first.
                        The latest processed CMS/CBS files for this business date are resolved automatically.
                    </div>
                    <group string="Daily Parameters">
                        <field name="business_date"/>
                        <field name="profile_id" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_process" type="object" string="Start Reconciliation" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_visa_detail_daily" model="ir.actions.act_window">
        <field name="name">Daily Reconciliation</field>
        <field name="res_model">visa.detail.daily.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Add the derived account type to every existing VX table and form. -->
    <record id="view_visa_vx_705_list_account_type" model="ir.ui.view">
        <field name="name">visa.vx.705.list.account.type</field><field name="model">visa.vx.705</field>
        <field name="inherit_id" ref="view_visa_vx_705_list"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_705_form_account_type" model="ir.ui.view">
        <field name="name">visa.vx.705.form.account.type</field><field name="model">visa.vx.705</field>
        <field name="inherit_id" ref="view_visa_vx_705_form"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_706_list_account_type" model="ir.ui.view">
        <field name="name">visa.vx.706.list.account.type</field><field name="model">visa.vx.706</field>
        <field name="inherit_id" ref="view_visa_vx_706_list"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_706_form_account_type" model="ir.ui.view">
        <field name="name">visa.vx.706.form.account.type</field><field name="model">visa.vx.706</field>
        <field name="inherit_id" ref="view_visa_vx_706_form"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_707_list_account_type" model="ir.ui.view">
        <field name="name">visa.vx.707.list.account.type</field><field name="model">visa.vx.707</field>
        <field name="inherit_id" ref="view_visa_vx_707_list"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_707_form_account_type" model="ir.ui.view">
        <field name="name">visa.vx.707.form.account.type</field><field name="model">visa.vx.707</field>
        <field name="inherit_id" ref="view_visa_vx_707_form"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_725_list_account_type" model="ir.ui.view">
        <field name="name">visa.vx.725.list.account.type</field><field name="model">visa.vx.725</field>
        <field name="inherit_id" ref="view_visa_vx_725_list"/>
        <field name="arch" type="xml"><field name="account_number" position="after"><field name="account_type_id"/></field></field>
    </record>
    <record id="view_visa_vx_725_form_account_type" model="ir.ui.view">
