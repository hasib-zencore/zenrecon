<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bsr_vss_import_document_wizard_form" model="ir.ui.view">
        <field name="name">bsr.vss.import.document.wizard.form</field>
        <field name="model">bsr.vss.import.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload VSS File" class="o_bsr_vss_wizard_form">
                <group>
                    <field name="file" filename="filename"
                           options="{'accepted_file_extensions': '.txt'}"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Upload a Visa settlement .txt file from your computer. The original file is retained with the processed import.
                </div>
                <footer>
                    <button name="action_import_and_process" string="Import and Process" type="object" class="btn-primary" icon="fa-cloud-upload"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bsr_vss_import_document_wizard" model="ir.actions.act_window">
        <field name="name">Upload VSS File</field>
        <field name="res_model">bsr.vss.import.document.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
