<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bsr_ipm_export_wizard_form" model="ir.ui.view">
        <field name="name">bsr.ipm.export.wizard.form</field>
        <field name="model">bsr.ipm.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete Mastercard XLSX">
                <div class="alert alert-success" role="alert">
                    The workbook contains file metadata, wide IPM records with every available DE, normalized data elements, and parsing errors.
                </div>
                <group>
                    <field name="file_data" filename="file_name" widget="binary"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer><button string="Close" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
