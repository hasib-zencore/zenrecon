        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
    <record id="rule_bsr_visa_dimension_option_company" model="ir.rule">
        <field name="name">VISA selection values by company</field>
        <field name="model_id" ref="model_bsr_visa_dimension_option"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
