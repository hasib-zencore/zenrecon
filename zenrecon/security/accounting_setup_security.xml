<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bank_reconciliation" model="ir.module.category">
        <field name="name">Bank Reconciliation</field>
        <field name="description">VSS matching, GL configuration, and voucher-report permissions</field>
        <field name="sequence">36</field>
    </record>
    <record id="privilege_bsr_access" model="res.groups.privilege">
        <field name="name">Bank Reconciliation Access</field>
        <field name="category_id" ref="module_category_bank_reconciliation"/>
    </record>
    <record id="privilege_bsr_approval" model="res.groups.privilege">
        <field name="name">Bank Reconciliation Approval</field>
        <field name="category_id" ref="module_category_bank_reconciliation"/>
    </record>

    <record id="group_bsr_report_operator" model="res.groups">
        <field name="name">Report Operator</field>
        <field name="privilege_id" ref="privilege_bsr_access"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_bsr_configuration_manager" model="res.groups">
        <field name="name">Configuration Administrator</field>
        <field name="privilege_id" ref="privilege_bsr_access"/>
        <field name="implied_ids" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
    <record id="group_bsr_report_checker" model="res.groups">
        <field name="name">Report Checker / Approver</field>
        <field name="privilege_id" ref="privilege_bsr_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>

    <record id="rule_bsr_accounting_configuration_company" model="ir.rule">
        <field name="name">Configurations by company</field>
        <field name="model_id" ref="model_bsr_accounting_configuration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
    <record id="rule_bsr_accounting_filter_option_company" model="ir.rule">
        <field name="name">Source filter options by company</field>
        <field name="model_id" ref="model_bsr_accounting_filter_option"/>
