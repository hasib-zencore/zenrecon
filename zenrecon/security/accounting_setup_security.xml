        <field name="model_id" ref="model_bsr_accounting_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
    <record id="rule_bsr_accounting_voucher_company" model="ir.rule">
        <field name="name">Vouchers by company</field>
        <field name="model_id" ref="model_bsr_accounting_voucher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
    <record id="rule_bsr_accounting_voucher_line_company" model="ir.rule">
        <field name="name">Voucher lines by company</field>
        <field name="model_id" ref="model_bsr_accounting_voucher_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
    <record id="rule_bsr_accounting_voucher_issue_company" model="ir.rule">
        <field name="name">Voucher issues by company</field>
        <field name="model_id" ref="model_bsr_accounting_voucher_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bsr_report_operator'))]"/>
    </record>
</odoo>
