<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_npsb_settlement_voucher_run_company" model="ir.rule">
        <field name="name">NPSB voucher runs by company</field>
        <field name="model_id" ref="model_npsb_settlement_voucher_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_npsb_settlement_voucher_line_company" model="ir.rule">
        <field name="name">NPSB voucher lines by company</field>
        <field name="model_id" ref="model_npsb_settlement_voucher_run_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
